# Copy to .env and fill in once AdSense has approved the site. Both values are read at build time,
# so a deploy has to be rebuilt for a change here to take effect.

# The AdSense publisher id, "ca-pub-" followed by sixteen digits. Leave it empty and no advertising
# code loads at all: no AdSense tag, no Funding Choices consent manager, and the ad slot stays an
# empty reserved box.
VITE_ADSENSE_CLIENT=

# The ad unit id of the slot below the guess table, from the AdSense ad unit's code snippet
# (data-ad-slot). Digits only. The live unit is already the built-in default, so this only needs a
# value to point a build at a different ad unit.
VITE_ADSENSE_SLOT=
