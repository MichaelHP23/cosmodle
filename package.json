{
  "name": "cosmodle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --noEmit -p functions/tsconfig.json && vite build && node scripts/generate-archive.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "schedule": "node scripts/extend-schedule.mjs",
    "verify:small-bodies": "node scripts/verify-small-bodies.mjs",
    "verify:constellations": "node scripts/verify-constellations.mjs",
    "verify:exoplanets": "node scripts/verify-exoplanets.mjs",
    "verify:star-sizes": "node scripts/verify-star-sizes.mjs",
    "dev:api": "wrangler pages dev --proxy 5173 -- npm run dev",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.124.0"
  }
}
